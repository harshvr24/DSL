---
// Exploded axonometric drawing of an AWS estate: one plate per capability, bottom to top.
// Pure CSS 3D; plates separate via --gap and the active one lifts via .is-active (see motion.ts).
import { caps } from '../content';
const tint = (i: number) => `color-mix(in srgb, #5F78F0 ${Math.round((i / (caps.length - 1)) * 100)}%, #FA5014)`;
---
<figure class="stack-fig" aria-hidden="true" data-stack>
  <div class="stack">
    {caps.map((c, i) => (
      <div class="plate" data-plate={i} style={`--i:${i}; --tint:${tint(i)}`}>
        <svg viewBox="0 0 200 200" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square">
          {c.art === 'source' && (
            <g>
              {[30, 80, 130].map((x) => [44, 114].map((y) => (
                <g><rect x={x} y={y} width="40" height="46" /><path d={`M${x + 6} ${y + 12}h28M${x + 6} ${y + 23}h28M${x + 6} ${y + 34}h28`} /></g>
              )))}
              <path d="M100 100V8m-7 9l7-9l7 9" stroke-dasharray="3 4" />
            </g>
          )}
          {c.art === 'zone' && (
            <g>
              <rect x="80" y="20" width="40" height="22" />
              <path d="M100 42v14M40 56h120M40 56v12M100 56v12M160 56v12" />
              {[20, 80, 140].map((x) => (
                <g><rect x={x} y="68" width="40" height="22" /><path d={`M${x + 20} 90v16M${x + 20} 132v12`} /><rect x={x} y="106" width="40" height="26" /><rect x={x} y="144" width="40" height="26" /></g>
              ))}
            </g>
          )}
          {c.art === 'platform' && (
            <g>
              {[18, 64, 110, 156].map((x) => <rect x={x} y="30" width="26" height="26" />)}
              <path d="M44 43h20m-5-4l5 4l-5 4M90 43h20m-5-4l5 4l-5 4M136 43h20m-5-4l5 4l-5 4" />
              <rect x="18" y="84" width="164" height="94" stroke-dasharray="4 4" />
              {[34, 72, 110, 148].map((x) => [98, 138].map((y) => <rect x={x} y={y} width="24" height="24" />))}
              <path d="M169 56v28" />
            </g>
          )}
          {c.art === 'data' && (
            <g>
              <path d="M14 66q8-9 16 0t16 0t16 0M14 100q8-9 16 0t16 0t16 0M14 134q8-9 16 0t16 0t16 0" />
              <ellipse cx="108" cy="58" rx="26" ry="9" />
              <path d="M82 58v84M134 58v84M82 100a26 9 0 0 0 52 0M82 142a26 9 0 0 0 52 0" />
              <rect x="150" y="66" width="36" height="70" />
              <path d="M150 84h36M150 102h36M150 120h36M168 66v70" />
              <path d="M66 100h12M136 100h12" stroke-dasharray="2 3" />
            </g>
          )}
          {c.art === 'guard' && (
            <g>
              <rect x="14" y="14" width="172" height="172" stroke-dasharray="6 5" />
              {[[42, 42], [118, 42], [42, 118], [118, 118]].map(([x, y]) => <rect x={x} y={y} width="40" height="40" />)}
              <circle cx="100" cy="100" r="11" />
              <path d="M82 82l10 10M118 82l-10 10M82 118l10-10M118 118l-10-10" />
              <path d="M14 30V14h16M170 14h16v16M186 170v16h-16M30 186H14v-16" stroke-width="3" />
            </g>
          )}
          {c.art === 'meter' && (
            <g>
              <path d="M26 24v152h160" />
              <rect x="46" y="54" width="20" height="122" /><rect x="80" y="84" width="20" height="92" />
              <rect x="114" y="110" width="20" height="66" /><rect x="148" y="128" width="20" height="48" />
              <path d="M26 122h160" stroke-dasharray="3 4" />
              <path d="M56 44l34 30l34 26l34 18" />
            </g>
          )}
          {c.art === 'run' && (
            <g>
              <path d="M14 122h44l10-44l14 78l12-56l8 22h84" />
              <circle cx="150" cy="50" r="24" />
              <path d="M150 34v16l11 7" />
              <path d="M14 170h172M30 164v6M60 164v6M90 164v6M120 164v6M150 164v6M180 164v6" />
            </g>
          )}
        </svg>
        <span class="plate-tag mono"><b>{c.n}</b> {c.plate}</span>
      </div>
    ))}
  </div>
  <span class="stack-note label">Fig. 6 — one estate, exploded</span>
</figure>

<style>
  .stack-fig { position: relative; margin: 0; width: 100%; aspect-ratio: 1 / 1.04; --gap: 44px; }
  .stack {
    position: absolute; left: 37%; top: 63%; width: 50%; aspect-ratio: 1;
    transform: translate(-50%, -50%) rotateX(57deg) rotateZ(-42deg);
    transform-style: preserve-3d;
  }
  .plate {
    position: absolute; inset: 0; transform-style: preserve-3d;
    transform: translateZ(calc(var(--i) * var(--gap) + var(--lift, 0px)));
    border: 1px solid var(--ink);
    background: color-mix(in srgb, var(--tint) 16%, rgb(255 255 255 / 0.62));
    transition: transform 520ms cubic-bezier(.2,.7,.2,1), background-color 400ms ease, border-color 400ms ease;
  }
  .plate svg { width: 100%; height: 100%; padding: 6%; color: var(--ink); transition: opacity 400ms ease; }
  /* label faces the screen: the inverse of the stack's rotation, anchored at the plate's right-hand corner */
  .plate-tag {
    position: absolute; left: 100%; top: 100%; white-space: nowrap; transform-origin: 0 0;
    transform: rotateZ(42deg) rotateX(-57deg) translate(34px, -0.75em);
    font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-muted);
    transition: color 300ms ease;
  }
  .plate-tag b { font-weight: 500; color: var(--ink); margin-right: 4px; }
  .plate-tag::before { content: ''; position: absolute; right: 100%; top: 50%; width: 26px; height: 1px; margin-right: 6px; background: var(--ink); }

  :global([data-stack].has-active) .plate:not(.is-active) { border-color: var(--rule); background: color-mix(in srgb, var(--tint) 8%, rgb(255 255 255 / 0.4)); }
  :global([data-stack].has-active) .plate:not(.is-active) svg { opacity: 0.28; }
  .plate.is-active { --lift: 20px; background: color-mix(in srgb, var(--tint) 46%, rgb(255 255 255 / 0.8)); border-width: 2px; }
  .plate.is-active .plate-tag { color: var(--ink); }
  .plate.is-active .plate-tag::before { height: 2px; }

  .stack-note { position: absolute; left: 0; bottom: 0; }

  @media (max-width: 1000px) {
    .stack-fig { max-width: 440px; --gap: 34px; }
    .stack { left: 33%; width: 46%; }
    .plate-tag b { display: none; }
  }
</style>
